// Cloudflare deployment: serve the static site in public/ (no server code).
{
  "name": "sovspreadle",
  "compatibility_date": "2026-11-23",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    { "pattern": "sovspreadle.app", "custom_domain": true },
    { "pattern": "www.sovspreadle.app", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public"
  }
}
